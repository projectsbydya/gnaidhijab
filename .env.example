# Flask Core
SECRET_KEY=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=name_db
DB_USER=root
DB_PASSWORD=

# Full connection URL — jika diisi, akan override DB_* di atas
DATABASE_URL=mysql+pymysql://root:@localhost/database_name

# Xendit Payment Gateway
XENDIT_SECRET_KEY=xnd_production_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
XENDIT_CALLBACK_TOKEN=
XENDIT_MODE=

# Biteship Shipping API
BITESHIP_API_KEY=biteship_live.xxxxxx
BITESHIP_BASE_URL=
BITESHIP_ORIGIN_POSTAL=
BITESHIP_ORIGIN_ADDRESS=
# Comma-separated courier codes. Available: jne,jnt,sicepat,anteraja,id-express,pos,tiki
BITESHIP_COURIERS=
# Webhook token — set this to the value you configure as "Headers Signature Secret"
# in the Biteship dashboard (Integration → Webhook Settings → Headers Signature).
# If left empty, incoming webhook requests will NOT be verified (insecure).
BITESHIP_WEBHOOK_TOKEN=

MAIL_SERVER=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=

# WhatsApp Contact
WHATSAPP_NUMBER=

# Rate Limiting (optional — use redis:// in production with multiple workers)
# pip install flask-limiter[redis]
RATELIMIT_STORAGE_URI=memory://

# Session Cookie Security
# Set SESSION_COOKIE_SECURE=true only in production (requires HTTPS)
SESSION_COOKIE_SECURE=false

ADMIN_EMAIL=
ADMIN_PASSWORD=

# Upload Folders (optional — defaults to static/ subdirectories)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=2097152
PRODUCT_UPLOAD_FOLDER=static/uploads/products
VIDEO_UPLOAD_FOLDER=static/videos
CTA_UPLOAD_FOLDER=static/images/cta
# Upload size limits (in bytes) - configurable via MAX_IMAGE_BYTES and MAX_VIDEO_BYTES
MAX_IMAGE_BYTES=20971520      # 20 MB
MAX_VIDEO_BYTES=52428800      # 50 MB

DEFAULT_SHIPPING_COST=

DEFAULT_ORDER_STATUS=
DEFAULT_PAYMENT_STATUS=

BANK_NAME=
BANK_ACCOUNT=
BANK_OWNER=

OTP_EXPIRE_SECONDS=
STORE_NAME=
# Optional: brand name for display (defaults to STORE_NAME if not set)
BRAND_NAME=
# Optional: place your logo in static/images/ and set the filename here (e.g. logo.png, logo.jpg)
# Leave empty to show STORE_NAME text instead.
LOGO_FILENAME=
# Your store public URL (used in emails, redirects)
STORE_URL=https://store_url

STORE_LOCATION=
XENDIT_BASE_URL=

# WhatsApp tooltip text (optional — defaults to "Chat on WhatsApp")
WHATSAPP_TOOLTIP=

# Social Media Links (optional — leave empty to hide from footer)
SOCIAL_INSTAGRAM=https://instagram_url
SOCIAL_TIKTOK=https://tiktok_url
SOCIAL_FACEBOOK=https://facebook_url
SOCIAL_SHOPEE=https://shopee_url

MAINTENANCE_MODE=

# ── TikTok Pixel ────────────────────────────────────────────────────────────
# Leave TIKTOK_PIXEL_ID empty to disable TikTok Pixel tracking entirely.
# Get your Pixel ID from TikTok Ads Manager → Assets → Events → Web Pixel.
TIKTOK_PIXEL_ID=

# ── Monitoring (Sentry) ────────────────────────────────────────────────────
# Leave SENTRY_DSN empty to disable error tracking entirely.
# Get your DSN from https://sentry.io → Project Settings → Client Keys.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Optional: set to a git SHA or release tag for release tracking.
SENTRY_RELEASE=
# Performance tracing sample rate: 0.0 (off) to 1.0 (100%). Default: 0.1 (10%)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Profiling sample rate (requires traces). Default: 0.0 (off)
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Set true to include user IP and email in Sentry events. Default: false
SENTRY_SEND_DEFAULT_PII=false